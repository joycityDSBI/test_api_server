# 텍스트 파일은 저장소에 LF로 통일, 체크아웃 시 OS에 맞게 변환
* text=auto

# Python / 설정 파일은 LF 고정
*.py text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.env text eol=lf
Dockerfile text eol=lf

# 바이너리 파일
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
